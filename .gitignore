# Old experiment checkpoints (abandoned judge-replacement model training,
# ~5.9GB, several files exceed GitHub's 100MB hard limit) - not part of the
# active LLM-judge research direction.
training/models/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Logs and runtime artifacts (regenerated by the pipeline, not source)
*_log.txt
*_log*.txt
heartbeat_log.txt
generate_v2_stdout.txt
training_log_v2.txt
viewer_v2_log.txt
server_log.txt
keep_awake_log.txt
compassjudger32b_pull.log
qwen35_9b_pull.log
heartbeat_task.xml

# WAL/SHM sidecar files (SQLite journal state, not meaningful without the main .db)
*.db-wal
*.db-shm

# Ground-truth study: keep the harness, exclude Python cache
ground_truth_study/__pycache__/

# PDF build intermediates (keep the script + final PDFs, not the _print.html copies)
pdf_build/*_print.html
pdf_build/__pycache__/

# Combiner-bias investigation intermediates. combiner_replay.db is matched by
# the *.db LFS filter, and it is a regenerable experiment cache (rebuild with
# training/combiner_replay.py), so keeping it out avoids spending account-wide
# LFS quota on an artifact that is not a result.
training/combiner_replay.db
training/replay_run.log
tunnel_app.log
tunnel_*.log

# V-Ideas build: the unpacked template tree is an intermediate (rebuild with
# deliverables/videas/fill_template.py); the packed .pptx is the deliverable.
deliverables/videas/unpacked/
